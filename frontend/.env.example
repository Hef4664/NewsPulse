# ============================================
# 前端环境变量示例文件（可提交到 git）
# 用法：复制本文件为 .env.local，填入真实值
#   cp .env.example .env.local
# .env.local 已被 .gitignore 忽略，不会进入版本库
# ============================================

# 阿里云 DashScope（灵积）API Key，用于 AI 问答功能
# 获取地址：https://bailian.console.aliyun.com/
# 注意：VITE_ 前缀的变量会在 vite build 时被内联进 dist 产物，
#       仅适用于本地开发。生产环境请改为后端代理转发，Key 只放服务端。
VITE_DASHSCOPE_API_KEY=your-api-key-here
